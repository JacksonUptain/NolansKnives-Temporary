{
  "projects": {
    "default": "nolansknives"
  },
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log"
    ]
  },
  "database": {
    "rules": "firebase-rules.json"
  },
  "storage": {
    "rules": "storage-rules.json"
  },
  "hosting": {
    "public": "build",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
