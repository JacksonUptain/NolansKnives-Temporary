{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nolansknives.com/seo/seo.config.schema.json",
  "title": "Nolan's Knives SEO configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "site", "pages", "aliases", "noindexPatterns"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "baseUrl",
        "language",
        "locale",
        "defaultImage",
        "defaultImageWidth",
        "defaultImageHeight",
        "defaultImageAlt",
        "email",
        "location",
        "description"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "format": "uri" },
        "language": { "type": "string", "minLength": 2 },
        "locale": { "type": "string", "minLength": 2 },
        "defaultImage": { "type": "string", "pattern": "^/" },
        "defaultImageWidth": { "type": "integer", "minimum": 1 },
        "defaultImageHeight": { "type": "integer", "minimum": 1 },
        "defaultImageAlt": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "description": { "type": "string", "minLength": 1 },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["city", "region", "country"],
          "properties": {
            "city": { "type": "string", "minLength": 1 },
            "region": { "type": "string", "minLength": 1 },
            "country": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "schemaType", "index", "sitemap"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path": { "type": "string", "pattern": "^/" },
          "pathPattern": { "type": "string", "pattern": "^/" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "schemaType": {
            "enum": ["WebPage", "CollectionPage", "AboutPage", "ContactPage", "ItemPage"]
          },
          "index": { "type": "boolean" },
          "sitemap": {
            "type": "object",
            "additionalProperties": false,
            "required": ["include"],
            "properties": {
              "include": { "type": "boolean" },
              "changeFrequency": {
                "enum": ["always", "hourly", "daily", "weekly", "monthly", "yearly", "never"]
              },
              "priority": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "oneOf": [
          {
            "required": ["path"],
            "not": { "required": ["pathPattern"] }
          },
          {
            "required": ["pathPattern"],
            "not": { "required": ["path"] }
          }
        ]
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "pattern": "^/" },
          "to": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "noindexPatterns": {
      "type": "array",
      "items": { "type": "string", "pattern": "^/" }
    }
  }
}
